# =============================================================================
# Zero-Knowledge File Encryption System
# Environment Configuration Template
#
# Instructions:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in ALL values marked with <CHANGE_ME>
#   3. Never commit your .env file to git
# =============================================================================

# ─── Application ──────────────────────────────────────────────────────────────
ENVIRONMENT=production
DATABASE_NAME=zero_knowledge_encryption

# ─── Security (REQUIRED) ──────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=<CHANGE_ME>

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=<CHANGE_ME>

# ─── MinIO Object Storage ─────────────────────────────────────────────────────
MINIO_ACCESS_KEY=<CHANGE_ME>
MINIO_SECRET_KEY=<CHANGE_ME>
MINIO_BUCKET_NAME=encrypted-files

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
# Gmail: use App Password (not your login password)
# https://support.google.com/accounts/answer/185833
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=<CHANGE_ME>
SMTP_PASSWORD=<CHANGE_ME>
FROM_EMAIL=<CHANGE_ME>

# ─── hCaptcha (optional, but recommended for production) ──────────────────────
# Get keys at: https://dashboard.hcaptcha.com/
# Set HCAPTCHA_ENABLED=false to disable during development
HCAPTCHA_SITE_KEY=<CHANGE_ME>
HCAPTCHA_SECRET_KEY=<CHANGE_ME>
HCAPTCHA_ENABLED=true

# ─── JWT Token Settings ───────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Rate Limiting ────────────────────────────────────────────────────────────
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION=300
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW=300
RATE_LIMIT_MAX_REQUESTS=100

# ─── File Upload ──────────────────────────────────────────────────────────────
MAX_FILE_SIZE=104857600
